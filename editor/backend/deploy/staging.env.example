# Server environment only. Never serve this file or put its values in frontend code.
OLV_EDITOR_ORIGIN=https://editor-staging.example.com
OLV_PUBLISH_MODE=github-staging
OLV_STATE_DIR=/var/lib/olv
OLV_GITHUB_APP_ID=
OLV_GITHUB_INSTALLATION_ID=
OLV_GITHUB_PRIVATE_KEY_FILE=/run/secrets/olv-github-app.pem
